NEXT_PUBLIC_API_URL=http://localhost:40005
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:4003

# Optional: a single-operator deployment can send the bare domain straight
# to one business's booking page.
# NEXT_PUBLIC_DEFAULT_BUSINESS=demo-canteen

# Branding in one place — mirrors the backend config/brand.js.
NEXT_PUBLIC_BRAND_PRODUCT_NAME=Chefo Booking
NEXT_PUBLIC_BRAND_SHORT_NAME=Booking
NEXT_PUBLIC_BRAND_DOMAIN=booking.chefo.in

# Firebase Web SDK — phone OTP for the optional customer account.
# Same project as booking-business; these are public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

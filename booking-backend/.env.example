# Chefo Booking — backend environment
# Same MongoDB Atlas cluster as the existing Chefo products, but its own
# DATABASE (chefo-booking). Separate data, shared infrastructure.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/chefo-booking?retryWrites=true&w=majority

# This product mints its own sessions, so it uses its own signing secret —
# a token from another Chefo app must never be valid here. 24+ characters.
JWT_SECRET=

PORT=40005
NODE_ENV=development

# Browser origins allowed to call this API with credentials.
ALLOWED_ORIGINS=http://localhost:4001,http://localhost:4003

# Branding/domain in one place — see config/brand.js.
BRAND_PRODUCT_NAME=Chefo Booking
BRAND_SHORT_NAME=Booking
BRAND_DOMAIN=booking.chefo.in
CUSTOMER_APP_URL=http://localhost:4003

# Transactional email via Brevo — password-reset codes go out from here.
# Get the key from the Brevo dashboard; MAIL_FROM must be a verified sender.
BREVO_API_KEY=
MAIL_FROM=Chefo Booking <no-reply@chefo.in>

# Firebase Admin — verifies the phone-OTP idToken the browser mints. Base64 of
# the service-account JSON for the same Firebase project the frontend uses.
#   Windows: certutil -encode key.json tmp.b64  (then strip the header lines)
#   Unix:    base64 -w0 key.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Seed defaults (npm run seed) — a demo business to sign into locally.
SEED_BUSINESS_NAME=Demo Canteen
SEED_BUSINESS_SLUG=demo-canteen
SEED_OWNER_NAME=Demo Owner
SEED_OWNER_EMAIL=owner@demo.test
SEED_OWNER_PHONE=+919000000001
SEED_OWNER_PASSWORD=booking123

# Optional demo outlets, comma-separated. Leave empty for a single-site business.
SEED_OUTLETS=

NEXT_PUBLIC_API_URL=http://localhost:40005
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:4003

# Branding in one place — mirrors the backend config/brand.js.
NEXT_PUBLIC_BRAND_PRODUCT_NAME=Chefo Booking
NEXT_PUBLIC_BRAND_SHORT_NAME=Booking
NEXT_PUBLIC_BRAND_DOMAIN=booking.chefo.in

# Firebase phone-OTP sign-in (public web config — shipped to every browser).
# Same project as the other Chefo apps, so a mobile number is one identity.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
